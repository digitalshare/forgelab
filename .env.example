# Infrastructure
FORGELAB_ENVIRONMENT=local
FORGELAB_DEBUG=true
FORGELAB_DATABASE_URL=postgresql+asyncpg://forgelab:forgelab@localhost:5432/forgelab
FORGELAB_REDIS_URL=redis://localhost:6379/0

# Daytona sandbox provider
FORGELAB_DAYTONA_API_KEY=
FORGELAB_DAYTONA_TARGET=us

# LLM providers — one per agent lane
FORGELAB_OPENAI_API_KEY=
FORGELAB_ANTHROPIC_API_KEY=
FORGELAB_QWEN_API_KEY=

# GitHub App (repository access + PR creation)
FORGELAB_GITHUB_APP_ID=
FORGELAB_GITHUB_PRIVATE_KEY=
FORGELAB_GITHUB_WEBHOOK_SECRET=

# Never place these values in a sandbox — agents receive short-lived scoped
# credentials from the broker (WO-022) instead.
